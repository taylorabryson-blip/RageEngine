<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compile-time stand-in for the game's ThunderRoad.dll (self-written declarations only). NOT shipped with the mod:
       the game provides the real one. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>ThunderRoad</AssemblyName>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <NoWarn>CS0067;CS0108;CS0114;CS0169;CS0414;CS0649;CS0618;CS8632</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../src/ThunderRoadStub/*.cs" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" PrivateAssets="all" />
  </ItemGroup>
</Project>
